# RPC endpoint for chain (localhost, Sepolia, Amoy, etc.)
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Admin wallet that deployed the contract (0x... private key)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Backend relayer key (can be same as PRIVATE_KEY for demo)
RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deployed SecureVote contract address
CONTRACT_ADDRESS=0xYourContractAddress

# Backend server
PORT=3000
OTP_EXPIRY_SECONDS=300
FACE_DISTANCE_THRESHOLD=0.6

# Deploy script parameters
CANDIDATES=Alice,Bob,Charlie
START_DELAY_SECONDS=30
DURATION_SECONDS=86400
